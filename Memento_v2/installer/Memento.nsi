; Per-user Windows x64 installer. Payload/uninstall list are generated by Python.
Unicode true
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "x64.nsh"
!include "Sections.nsh"

!ifndef PRODUCT_ID
  !define PRODUCT_ID "Memento_v2"
!endif
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_ID}"
Name "Memento_v2 ${APP_VERSION}"
Icon "${APP_ICON}"
UninstallIcon "${APP_ICON}"
OutFile "${SETUP_OUTPUT}"
InstallDir "$LOCALAPPDATA\Programs\Memento_v2"
InstallDirRegKey HKCU "${UNINSTALL_KEY}" "InstallLocation"
RequestExecutionLevel user
ManifestDPIAware true
AllowRootDirInstall false
!ifdef TEST_INSTALLER
  SetCompress off
!else
  SetCompressor /SOLID lzma
  SetCompressorDictSize 32
!endif
ShowInstDetails show
ShowUninstDetails show
VIProductVersion "${VERSION_QUAD}"
VIAddVersionKey /LANG=1031 "ProductName" "Memento_v2"
VIAddVersionKey /LANG=1031 "FileDescription" "Memento_v2 Setup"
VIAddVersionKey /LANG=1031 "FileVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=1031 "LegalCopyright" "Memento_v2 Projekt"

!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TITLE "Memento_v2 installieren"
!define MUI_WELCOMEPAGE_TEXT "Lokaler Familienvideo-Editor.$\r$\n$\r$\nDie Installation gilt für dein Windows-Benutzerkonto und benötigt keine Administratorrechte.$\r$\n$\r$\nBibliothek, Filme und API-Schlüssel bleiben bei Updates und Deinstallation erhalten. Gemini-Analysen werden erst in der Anwendung ausdrücklich gestartet."
!insertmacro MUI_PAGE_WELCOME
!define MUI_LICENSEPAGE_TEXT_TOP "OpenMemento steht unter der GNU General Public License, Version 3 vom 29. Juni 2007."
!define MUI_LICENSEPAGE_TEXT_BOTTOM "Mit Weiter setzt du die Installation fort. Die vollständige GPLv3 findest du nach der Installation im Programmordner als LICENSE."
!define MUI_LICENSEPAGE_BUTTON "Weiter >"
!insertmacro MUI_PAGE_LICENSE "${__FILEDIR__}\..\..\LICENSE"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\Memento_v2.exe"
!define MUI_FINISHPAGE_RUN_NOTCHECKED
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH
!insertmacro MUI_LANGUAGE "German"

Var Upgrade

!macro TestError TEXT
  !ifdef TEST_INSTALLER
    FileOpen $9 "${TEST_LOG}" a
    FileWriteUTF16LE $9 "${TEXT}$\r$\n"
    FileClose $9
  !endif
!macroend

Function .onInit
  SetShellVarContext current
  SetRegView 64
  ${IfNot} ${RunningX64}
    !insertmacro TestError "Not x64"
    MessageBox MB_OK|MB_ICONSTOP "Memento_v2 benötigt Windows mit 64 Bit." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}
  ReadRegDWORD $0 HKCU "${UNINSTALL_KEY}" "DesktopShortcut"
  ${GetParameters} $1
  ClearErrors
  ${GetOptions} $1 "/DESKTOP=" $2
  ${IfNot} ${Errors}
    StrCpy $0 $2
  ${EndIf}
  ${If} $0 == 1
    !insertmacro SelectSection 1
  ${EndIf}
FunctionEnd

Function ValidateDirectory
  ${GetRoot} "$INSTDIR" $0
  ${If} $0 == ""
    SetErrorLevel 2
    Abort "Bitte einen vollständigen Installationspfad wählen."
  ${EndIf}
  ${GetFileName} "$INSTDIR" $0
  ${If} $0 != "Memento_v2"
    !insertmacro TestError "Invalid folder name: $INSTDIR [$0]"
    MessageBox MB_OK|MB_ICONSTOP "Bitte einen eigenen Programmordner mit dem Namen Memento_v2 wählen." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}
  ${DirState} "$INSTDIR" $0
  ${If} $0 == 1
    ClearErrors
    FileOpen $1 "$INSTDIR\.memento-install-id" r
    FileRead $1 $2
    FileClose $1
    ${If} ${Errors}
    ${OrIf} $2 != "${PRODUCT_ID}"
      !insertmacro TestError "Unowned folder: $INSTDIR [$2]"
      MessageBox MB_OK|MB_ICONSTOP "Dieser Ordner enthält keine passende Memento_v2-Installation. Bitte einen leeren eigenen Programmordner wählen." /SD IDOK
      SetErrorLevel 2
      Abort
    ${EndIf}
  ${EndIf}
FunctionEnd

!macro CheckClosed PREFIX
Function ${PREFIX}CheckClosed
  IfFileExists "$INSTDIR\Memento_v2.exe" 0 done
  ClearErrors
  FileOpen $0 "$INSTDIR\Memento_v2.exe" a
  ${If} ${Errors}
    !insertmacro TestError "Program file locked: $INSTDIR"
    MessageBox MB_OK|MB_ICONSTOP "Bitte Memento_v2 vor Installation oder Deinstallation schließen." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}
  FileClose $0
  done:
FunctionEnd
!macroend
!insertmacro CheckClosed ""
!insertmacro CheckClosed "un."

Section "Memento_v2 (erforderlich)" MainSection
  SectionIn RO
  Call ValidateDirectory
  Call CheckClosed
  IfFileExists "$INSTDIR\Uninstall.exe" 0 extract
    ExecWait '"$INSTDIR\Uninstall.exe" /S /UPGRADE _?=$INSTDIR' $0
    ${If} $0 != 0
      SetErrorLevel 2
      Abort "Die vorherige Version konnte nicht entfernt werden."
    ${EndIf}
  extract:
  SetOutPath "$INSTDIR"
  FileOpen $0 "$INSTDIR\.memento-install-id" w
  FileWrite $0 "${PRODUCT_ID}"
  FileClose $0
  SetOverwrite on
  ClearErrors
  File /r "${PAYLOAD_DIR}\*"
  ; Also include the canonical project license when packaging an older bundle.
  !if /FileExists "${PAYLOAD_DIR}\LICENSE"
  !else
    File /oname=LICENSE "${__FILEDIR__}\..\..\LICENSE"
  !endif
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  ${If} ${Errors}
    !insertmacro TestError "Extraction failed: $INSTDIR"
    SetErrorLevel 2
    Abort "Programmdateien konnten nicht vollständig installiert werden."
  ${EndIf}
  SetOutPath "$INSTDIR"
  CreateDirectory "$SMPROGRAMS\${PRODUCT_ID}"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_ID}\Memento_v2.lnk" "$INSTDIR\Memento_v2.exe"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_ID}\Deinstallieren.lnk" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "Memento_v2"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "Publisher" "Memento_v2"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\Memento_v2.exe"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegStr HKCU "${UNINSTALL_KEY}" "QuietUninstallString" '$\"$INSTDIR\Uninstall.exe$\" /S'
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "EstimatedSize" ${INSTALLED_KB}
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "DesktopShortcut" 0
SectionEnd

Section /o "Desktop-Verknüpfung"
  CreateShortcut "$DESKTOP\${PRODUCT_ID}.lnk" "$INSTDIR\Memento_v2.exe"
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "DesktopShortcut" 1
SectionEnd

Function un.onInit
  SetShellVarContext current
  SetRegView 64
  ClearErrors
  FileOpen $0 "$INSTDIR\.memento-install-id" r
  FileRead $0 $1
  FileClose $0
  ${If} ${Errors}
  ${OrIf} $1 != "${PRODUCT_ID}"
    SetErrorLevel 2
    Abort "Der Installationsordner konnte nicht sicher zugeordnet werden."
  ${EndIf}
  Call un.CheckClosed
  StrCpy $Upgrade 0
  ${GetParameters} $0
  ClearErrors
  ${GetOptions} $0 "/UPGRADE" $1
  ${IfNot} ${Errors}
    StrCpy $Upgrade 1
  ${EndIf}
FunctionEnd

Section "Uninstall"
  ; Exact generated ownership list: never recursively delete an install directory.
  !include "${UNINSTALL_LIST}"
  Delete "$INSTDIR\LICENSE"
  Delete "$INSTDIR\.memento-install-id"
  Delete "$SMPROGRAMS\${PRODUCT_ID}\Memento_v2.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_ID}\Deinstallieren.lnk"
  RMDir "$SMPROGRAMS\${PRODUCT_ID}"
  ReadRegDWORD $0 HKCU "${UNINSTALL_KEY}" "DesktopShortcut"
  ${If} $0 == 1
    Delete "$DESKTOP\${PRODUCT_ID}.lnk"
  ${EndIf}
  DeleteRegKey HKCU "${UNINSTALL_KEY}"
  ${If} $Upgrade != 1
    Delete "$INSTDIR\Uninstall.exe"
    RMDir "$INSTDIR"
  ${EndIf}
SectionEnd
